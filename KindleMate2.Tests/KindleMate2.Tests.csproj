<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 只引用 Application/Infrastructure/Domain,不依赖 WinForms,因此可跨平台运行 -->
    <!--
      Windows 宿主上把测试本身也编到 net10.0-windows:只有这样才能条件引用
      Devices.Windows(Windows 专有实现,单目标 net10.0-windows),从而给
      DeviceManager 的默认状态 / Dispose 幂等 / 无设备守卫补 CI 回归
      (启用前该 434 行类在 CI 里零覆盖 —— Windows 恰是主平台)。
      非 Windows 宿主仍只编 net10.0:Devices.Windows 是 net10.0-windows 单目标,
      从 net10.0 引用它会在 ubuntu/macOS 上还原失败。
      注:net10.0-windows **自带 WINDOWS 常量**,Windows 专有的用例文件用 #if WINDOWS 圈起。
    -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\KindleMate2.Application\KindleMate2.Application.csproj" />
    <ProjectReference Include="..\KindleMate2.Infrastructure\KindleMate2.Infrastructure.csproj" />
    <ProjectReference Include="..\KindleMate2.Domain\KindleMate2.Domain.csproj" />
    <!-- macOS 设备实现是纯 BCL 的中性 net10.0 程序集(与 Devices.Windows 不同,它没有平台专有依赖),
         因此可以在任何平台上编译+测试;用例通过构造函数把"卷根目录"指到临时目录,
         于是"扫卷判定 + 轮询防抖"这段逻辑得以跨平台回归。 -->
    <ProjectReference Include="..\KindleMate2.Devices.MacOS\KindleMate2.Devices.MacOS.csproj" />
    <!-- macOS / Linux 共用的设备实现:libmtp 绑定、只读 USB 探测、卷扫描都在这 -->
    <ProjectReference Include="..\KindleMate2.Devices.Posix\KindleMate2.Devices.Posix.csproj" />
    <!-- Linux 薄壳(候选挂载根不同),用于验证多根遍历;与 Devices.MacOS 一样是中性 net10.0 -->
    <ProjectReference Include="..\KindleMate2.Devices.Linux\KindleMate2.Devices.Linux.csproj" />
  </ItemGroup>
  <!-- Windows 专有设备实现:仅在 Windows 宿主上引用(见 TargetFramework 的条件注释)。 -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ProjectReference Include="..\KindleMate2.Devices.Windows\KindleMate2.Devices.Windows.csproj" />
  </ItemGroup>
</Project>
