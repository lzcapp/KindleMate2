<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <!-- Windows 上用 WinExe(不弹控制台);其他平台用普通 Exe -->
    <OutputType Condition="'$(TargetFramework)' == 'net10.0-windows'">WinExe</OutputType>
    <OutputType Condition="'$(TargetFramework)' != 'net10.0-windows'">Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>KindleMate2.Avalonia</RootNamespace>
    <AssemblyName>KindleMate2.Avalonia</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <Product>Kindle Mate 2</Product>
    <Company>lzcapp</Company>
    <Copyright>Copyright © 2026 lzcapp</Copyright>
    <Version>2026.09.17</Version>
  </PropertyGroup>

  <!-- 程序图标:沿用原版 WinForms 壳的 bookmark.ico(与仓库根 bookmark.ico 字节一致)。
       ApplicationIcon 是属性 → 决定 exe 的 Win32 图标;AvaloniaResource 是项 → 供窗口 Icon 在运行时加载。 -->
  <PropertyGroup>
    <ApplicationIcon>Assets/bookmark.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/bookmark.ico" />
    <!-- 关于窗口的图标位需要 IImage,而 WindowIcon 不能直接给 Image 用,
         故另附一份从 .ico 的 256×256 PNG 帧抽出的 PNG(自带透明通道)。 -->
    <AvaloniaResource Include="Assets/bookmark.png" />
    <!-- 菜单栏「Kindle设备已连接」按钮的图标,取自原版 WinForms 的 Resources
         (带 tRNS 透明背景,深浅主题下都能用)。 -->
    <AvaloniaResource Include="Assets/mobile-phone-with-arrow.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- 复用现有分层:Application(导入/导出/维护/设备接口)+ Infrastructure(仓储/SQLite)+ Domain(实体)+ Shared(常量/文案) -->
    <ProjectReference Include="..\KindleMate2.Application\KindleMate2.Application.csproj" />
    <ProjectReference Include="..\KindleMate2.Infrastructure\KindleMate2.Infrastructure.csproj" />
    <ProjectReference Include="..\KindleMate2.Domain\KindleMate2.Domain.csproj" />
    <ProjectReference Include="..\KindleMate2.Shared\KindleMate2.Shared.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <!-- Windows 专有的 Kindle 设备实现只在 Windows TFM 下引入;其他平台由 NullDeviceManager 兜底 -->
    <ProjectReference Include="..\KindleMate2.Devices.Windows\KindleMate2.Devices.Windows.csproj" />
  </ItemGroup>

  <!-- macOS 专有的 Kindle 设备实现。这里必须**同时**判 TFM 与宿主 OS,缺一不可:
       · 只判 TFM 不行 —— net10.0 这个 TFM 由 Linux 与 macOS 共用,那样 Linux 也会引用到
         macOS 实现,与下面 MACOS 常量的定义不匹配,还会往 Linux 产物里塞一份用不上的 dll;
       · 只判 OS 不行 —— 在 macOS 上构建 net10.0-windows 变体时会被误引入。
       两处引用共用一个属性,避免条件写两遍后改一处漏一处。 -->
  <PropertyGroup>
    <IsMacOsDesktop Condition="'$(TargetFramework)' == 'net10.0' AND $([MSBuild]::IsOSPlatform('OSX'))">true</IsMacOsDesktop>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsMacOsDesktop)' == 'true'">
    <!-- MACOS 不是 SDK 预定义常量:它是平台专有 TFM(net10.0-macos)才有的符号,
         而本壳在 macOS 上走的是中性的 net10.0。故由条件引用方显式定义,
         供 DatabaseSession.CreateDeviceManager 与 WINDOWS 对称地做编译期选择。 -->
    <DefineConstants>$(DefineConstants);MACOS</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsMacOsDesktop)' == 'true'">
    <ProjectReference Include="..\KindleMate2.Devices.MacOS\KindleMate2.Devices.MacOS.csproj" />
  </ItemGroup>

</Project>
