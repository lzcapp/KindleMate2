<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:KindleMate2.Avalonia.ViewModels"
             xmlns:shared="using:KindleMate2.Shared"
             x:Class="KindleMate2.Avalonia.Views.ShareCardView"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="1350"
             x:DataType="vm:ShareCardModel"
             Width="1080" MinHeight="1350">

  <!--
    单条标注的分享卡片。版式(2026-09-22 定):
      页眉:类型标签 + 应用名 → 标注正文(hero,带强调竖线) → 分隔线 → 书名 → 作者 → 页脚署名

    尺寸 1080×1350(4:5 竖版)。**高度自适应**:MinHeight 保证短正文也出一张 1350 的卡片,
    正文很长时卡片往下长(第 3 行那个 `*` 空行负责把页脚顶到底部,长文时它自然收成 0)。

    颜色全部走 DynamicResource 的应用令牌 ⇒ 自动跟随应用当前主题(深浅两套 App.axaml 里都有)。
    **字号与间距是设计稿的固定值**(1080 宽画布上的像素),不随主题变。
  -->
  <Border Background="{DynamicResource KmCanvasBrush}" Padding="96">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

      <!-- 页眉 -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
        <!-- 类型标签:复用应用里那四套 chip 配色(划线=蓝/笔记=橙/书签=青/摘抄=粉),
             只把内边距与字号按卡片的尺度放大 —— 与应用里的视觉语言保持一致。 -->
        <Border Grid.Column="0" Classes="chip" Padding="18,6"
                IsVisible="{Binding HasType}"
                Classes.highlight="{Binding IsHighlight}" Classes.note="{Binding IsNote}"
                Classes.bookmark="{Binding IsBookmark}" Classes.cut="{Binding IsCut}"
                VerticalAlignment="Center">
          <TextBlock Text="{Binding TypeText}" FontSize="28" />
        </Border>
        <TextBlock Grid.Column="2" Text="KINDLE MATE 2" FontSize="28" VerticalAlignment="Center"
                   Foreground="{DynamicResource KmTextTertiaryBrush}" />
      </Grid>

      <!-- 标注正文(hero):左侧那根竖线与列表里的 kbar 同源 -->
      <Grid Grid.Row="1" ColumnDefinitions="6,*" Margin="0,100,0,0">
        <Border Grid.Column="0" Background="{DynamicResource KmAccentBrush}" CornerRadius="3" />
        <TextBlock Grid.Column="1" Margin="36,0,0,0" Text="{Binding Quote}" TextWrapping="Wrap"
                   FontSize="42" LineHeight="64" Foreground="{DynamicResource KmTextBrush}" />
      </Grid>

      <!-- 书名 + 作者(页数/日期按用户要求舍去) -->
      <StackPanel Grid.Row="2" Margin="0,100,0,0">
        <Rectangle Height="1" Fill="{DynamicResource KmBorderBrush}" />
        <TextBlock Text="{Binding BookName}" IsVisible="{Binding HasBookName}" Margin="0,56,0,0"
                   FontSize="32" LineHeight="46" FontWeight="Medium"
                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource KmTextBrush}" />
        <TextBlock Text="{Binding AuthorName}" IsVisible="{Binding HasAuthor}" Margin="0,12,0,0"
                   FontSize="28" LineHeight="40" TextWrapping="Wrap"
                   Foreground="{DynamicResource KmTextSecondaryBrush}" />
      </StackPanel>

      <!-- 页脚署名 -->
      <TextBlock Grid.Row="4" Margin="0,80,0,0" FontSize="28"
                 Text="{x:Static shared:Strings.Ui_Share_Footer}"
                 Foreground="{DynamicResource KmTextTertiaryBrush}" />

    </Grid>
  </Border>
</UserControl>
