<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:KindleMate2.Avalonia.ViewModels"
        xmlns:dg="using:Avalonia.Controls"
        x:Class="KindleMate2.Avalonia.Views.MainWindow"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:DataType="vm:MainWindowViewModel"
        Title="KindleMate2 · Avalonia Shell"
        Width="1100" Height="700"
        WindowStartupLocation="CenterScreen"
        Opened="OnOpened">

  <DockPanel>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="10,10,10,6">
      <TextBox Grid.Column="0" Text="{Binding DbPath, Mode=TwoWay}"
               PlaceholderText="数据库路径(KM2.db),也可拖入或作为启动参数"/>
      <Button Grid.Column="1" Content="打开数据库…" Margin="8,0,0,0"
              IsEnabled="{Binding !IsBusy}" Click="OnOpenDatabaseClick"/>
      <ProgressBar Grid.Column="2" Width="120" Margin="8,0,0,0" IsIndeterminate="True"
                   IsVisible="{Binding IsBusy}" VerticalAlignment="Center"/>
    </Grid>

    <Grid DockPanel.Dock="Bottom" Margin="10,4,10,8">
      <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Grid>

    <Grid ColumnDefinitions="280,*" Margin="10,2,10,0">

      <DockPanel Grid.Column="0" Margin="0,0,8,0">
        <TextBlock DockPanel.Dock="Top" Text="书籍" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ListBox ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:BookItem">
              <TextBlock Text="{Binding}"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <dg:DataGrid Grid.Column="1" ItemsSource="{Binding Clippings}"
                   AutoGenerateColumns="False" IsReadOnly="True"
                   GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                   Margin="0,0,0,2">
        <dg:DataGrid.Columns>
          <dg:DataGridTextColumn Header="书" Binding="{Binding BookName}" Width="180"/>
          <dg:DataGridTextColumn Header="作者" Binding="{Binding AuthorName}" Width="100"/>
          <dg:DataGridTextColumn Header="页码" Binding="{Binding PageNumber}" Width="56"/>
          <dg:DataGridTextColumn Header="位置" Binding="{Binding ClippingTypeLocation}" Width="110"/>
          <dg:DataGridTextColumn Header="时间" Binding="{Binding ClippingDate}" Width="150"/>
          <dg:DataGridTextColumn Header="类型" Binding="{Binding BriefType}" Width="64"/>
          <dg:DataGridTextColumn Header="内容" Binding="{Binding Content}" Width="*"/>
        </dg:DataGrid.Columns>
      </dg:DataGrid>

    </Grid>

  </DockPanel>
</Window>
