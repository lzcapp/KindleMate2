<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:KindleMate2.Avalonia.ViewModels"
        xmlns:models="using:KindleMate2.Avalonia.Models"
        xmlns:dg="using:Avalonia.Controls"
        x:Class="KindleMate2.Avalonia.Views.MainWindow"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="780"
        x:DataType="vm:MainWindowViewModel"
        Title="Kindle Mate 2"
        Width="1200" Height="780" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Opened="OnOpened">

  <Window.Styles>
    <Style Selector="TextBox.inline">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox.flat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Button.seg">
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="11,3" />
      <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Padding" Value="6" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="MinWidth" Value="30" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- 顶部菜单行 -->
    <Border DockPanel.Dock="Top" Height="32" Background="{DynamicResource KmChromeBrush}"
            BorderBrush="{DynamicResource KmBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*" Margin="12,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <Border Width="13" Height="13" CornerRadius="3" Background="{DynamicResource KmAccentBrush}" />
          <TextBlock Text="Kindle Mate 2" FontSize="12" VerticalAlignment="Center"
                     Foreground="{DynamicResource KmTextSecondaryBrush}" Margin="0,0,8,0" />
          <Menu VerticalAlignment="Center">
            <MenuItem Header="文件(_F)">
              <MenuItem Header="打开数据库…" Click="OnMenuOpenDatabase" />
              <MenuItem Header="刷新" Click="OnMenuRefresh" />
              <MenuItem Header="统计" Click="OnMenuStatistics" />
              <Separator />
              <MenuItem Header="重启" Click="OnMenuRestart" />
              <MenuItem Header="退出" Click="OnMenuExit" />
            </MenuItem>
            <MenuItem Header="管理(_M)">
              <MenuItem Header="导入 Kindle 标注" Click="OnMenuImportClippings" />
              <MenuItem Header="导入 Kindle 生词本" Click="OnMenuImportVocab" />
              <MenuItem Header="导入 Kindle Mate 数据库" Click="OnMenuImportKmDatabase" />
              <MenuItem Header="导入 KMate 数据库" Click="OnMenuImportKmateDatabase" />
              <MenuItem Header="从 Kindle 设备导入" Click="OnMenuImportFromDevice" IsVisible="False" />
              <MenuItem Header="同步到 Kindle 设备" Click="OnMenuSyncToDevice" />
              <Separator />
              <MenuItem Header="导出为 Markdown" Click="OnMenuExportMarkdown" />
              <MenuItem Header="清理数据库" Click="OnMenuCleanDb" />
              <MenuItem Header="重建数据库" Click="OnMenuRebuildDb" />
              <MenuItem Header="备份" Click="OnMenuBackup" />
              <MenuItem Header="清空数据" Click="OnMenuDeleteAll" />
            </MenuItem>
            <MenuItem Header="帮助(_H)">
              <MenuItem Header="关于" Click="OnMenuAbout" />
              <MenuItem Header="GitHub 仓库" Click="OnMenuGithub" />
            </MenuItem>
          </Menu>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 命令栏:全局搜索 + 视图 / 主题 / 语言 -->
    <Border DockPanel.Dock="Top" Height="48" Background="{DynamicResource KmSurfaceBrush}"
            BorderBrush="{DynamicResource KmBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" Margin="12,0" VerticalAlignment="Center">
        <Border Grid.Column="0" Height="30" MaxWidth="520" HorizontalAlignment="Left"
                Background="{DynamicResource KmRaisedBrush}" BorderBrush="{DynamicResource KmBorderStrongBrush}"
                BorderThickness="0.5" CornerRadius="7" Padding="9,0">
          <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <Path Grid.Column="0" Width="14" Height="14" Stretch="None"
                  Stroke="{DynamicResource KmTextTertiaryBrush}" StrokeThickness="1.5"
                  Data="M6.5 2A4.5 4.5 0 1 1 6.5 11A4.5 4.5 0 0 1 6.5 2Z M9.8 9.8L13.5 13.5" />
            <TextBox Grid.Column="1" Classes="inline" Text="{Binding SearchText, Mode=TwoWay}"
                     PlaceholderText="搜索标注、书名、作者…" />
            <ComboBox Grid.Column="2" Classes="flat" Width="74"
                      ItemsSource="{Binding SearchTypes}" SelectedItem="{Binding SearchType, Mode=TwoWay}" />
          </Grid>
        </Border>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Background="{DynamicResource KmRaisedBrush}" BorderBrush="{DynamicResource KmBorderBrush}"
                  BorderThickness="0.5" CornerRadius="6" Padding="2">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Classes="ghost seg" Classes.active="{Binding IsListMode}" Content="列表" Click="OnShowList" />
              <Button Classes="ghost seg" Classes.active="{Binding IsTableMode}" Content="表格" Click="OnShowTable" />
            </StackPanel>
          </Border>

          <Button Classes="ghost icon" Click="OnToggleTheme" ToolTip.Tip="切换深色 / 浅色">
            <Path Width="14" Height="14" Stretch="None" Stroke="{DynamicResource KmTextSecondaryBrush}" StrokeThickness="1.3"
                  Data="M12.5 9.8A5.5 5.5 0 0 1 6.2 3.5A5.5 5.5 0 1 0 12.5 9.8Z" />
          </Button>

          <Button Classes="ghost icon" ToolTip.Tip="界面语言">
            <Path Width="14" Height="14" Stretch="None" Stroke="{DynamicResource KmAccentBrush}" StrokeThickness="1.3"
                  Data="M8 2.5A5.5 5.5 0 1 1 8 13.5A5.5 5.5 0 0 1 8 2.5Z M2.5 8H13.5 M8 2.5C9.9 4.6 9.9 11.4 8 13.5 M8 2.5C6.1 4.6 6.1 11.4 8 13.5" />
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="简体中文" Click="OnLanguageHans" />
                <MenuItem Header="繁体中文" Click="OnLanguageHant" />
                <MenuItem Header="英文" Click="OnLanguageEn" />
                <MenuItem Header="跟随系统" Click="OnLanguageAuto" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 状态栏 -->
    <Border DockPanel.Dock="Bottom" Height="28" Background="{DynamicResource KmSurfaceBrush}"
            BorderBrush="{DynamicResource KmBorderBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" Margin="12,0" VerticalAlignment="Center">
        <TextBlock Grid.Column="0" Classes="tt" Text="{Binding StatusLeft}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="tt" Text="{Binding StatusText}" VerticalAlignment="Center" Margin="14,0,0,0" />
        <ProgressBar Grid.Column="3" Width="110" IsIndeterminate="True" VerticalAlignment="Center"
                     IsVisible="{Binding IsProgressVisible}" />
        <TextBlock Grid.Column="4" Classes="tt" Text="读取中" Margin="8,0" VerticalAlignment="Center"
                   IsVisible="{Binding IsProgressVisible}" />
        <TextBlock Grid.Column="5" Classes="dot" Text="·" Margin="8,0" VerticalAlignment="Center"
                   IsVisible="{Binding IsProgressVisible}" />
        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Ellipse Width="6" Height="6" Fill="{DynamicResource KmTextTertiaryBrush}" />
          <TextBlock Classes="tt" Text="{Binding DeviceStatus}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 主体:左导航 | 内容 | 预览 -->
    <Grid ColumnDefinitions="236,3,*,3,330">

      <Border Grid.Column="0" Background="{DynamicResource KmSurfaceBrush}">
        <DockPanel Margin="8,10">
          <Border DockPanel.Dock="Top" Background="{DynamicResource KmRaisedBrush}" CornerRadius="7" Padding="2">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="2">
              <Button Grid.Column="0" Classes="ghost seg" Classes.active="{Binding IsClipDomain}"
                      Content="标注" HorizontalAlignment="Stretch" Click="OnSelectClipDomain" />
              <Button Grid.Column="1" Classes="ghost seg" Classes.active="{Binding IsWordDomain}"
                      Content="生词本" HorizontalAlignment="Stretch" Click="OnSelectWordDomain" />
            </Grid>
          </Border>

          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="4,14,4,6">
            <TextBlock Grid.Column="0" Classes="tt" Text="{Binding NavSectionTitle}" />
            <TextBlock Grid.Column="1" Classes="tt" Text="{Binding NavSectionCount}" />
          </Grid>

          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource KmBorderBrush}" BorderThickness="0,1,0,0"
                  Padding="8,9" Margin="0,8,0,0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="回收站" FontSize="12"
                         Foreground="{DynamicResource KmTextSecondaryBrush}" />
              <TextBlock Grid.Column="1" Classes="ts" Text="{Binding DeletedCount}" />
            </Grid>
          </Border>

          <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav, Mode=TwoWay}">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="刷新" Click="OnRefreshCurrent" />
                <MenuItem Header="导出" Click="OnExportCurrent" />
                <MenuItem Header="重命名" Click="OnRenameCurrent" />
                <MenuItem Header="删除" Click="OnDeleteSelected" />
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:NavItem">
                <Grid ColumnDefinitions="3,*,Auto" ColumnSpacing="8">
                  <Border Grid.Column="0" Classes="kbar" Width="3" CornerRadius="2" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Classes="ts" Text="{Binding CountText}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Width="3" />

      <Grid Grid.Column="2" RowDefinitions="38,*">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Margin="14,0" VerticalAlignment="Center">
          <TextBlock Grid.Column="0" Text="{Binding HeaderTitle}" FontSize="12" FontWeight="SemiBold"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1" Classes="tt" Text="{Binding HeaderSubtitle}" Margin="8,0,0,0"
                     VerticalAlignment="Center" />
          <Button Grid.Column="3" Classes="ghost seg" Content="{Binding SortLabel}" Click="OnToggleSort" />
        </Grid>

        <Grid Grid.Row="1">

          <ListBox IsVisible="{Binding ShowList}" ItemsSource="{Binding Items}"
                   SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="刷新" Click="OnRefreshCurrent" />
                <MenuItem Header="复制" Click="OnContextCopy" />
                <MenuItem Header="删除" Click="OnDeleteSelected" />
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:ListItem">
                <Grid ColumnDefinitions="3,*" ColumnSpacing="10">
                  <Border Grid.Column="0" Classes="kbar" Width="3" CornerRadius="2" />
                  <StackPanel Grid.Column="1" Spacing="5">
                    <TextBlock Text="{Binding Primary}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <TextBlock Classes="ts" Text="{Binding MetaText}" IsVisible="{Binding HasMeta}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Border Classes="chip" IsVisible="{Binding HasType}"
                                Classes.highlight="{Binding IsHighlight}" Classes.note="{Binding IsNote}"
                                Classes.bookmark="{Binding IsBookmark}" Classes.cut="{Binding IsCut}"
                                VerticalAlignment="Center">
                          <TextBlock Text="{Binding TypeText}" />
                        </Border>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Classes="tt" Text="{Binding Time}"
                                 IsVisible="{Binding HasTime}" VerticalAlignment="Center" />
                    </Grid>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <dg:DataGrid IsVisible="{Binding ShowClipTable}" ItemsSource="{Binding ClipTable}"
                       SelectedItem="{Binding SelectedClipTable, Mode=TwoWay}"
                       AutoGenerateColumns="False" IsReadOnly="True">
            <dg:DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="刷新" Click="OnRefreshCurrent" />
                <MenuItem Header="复制" Click="OnContextCopy" />
                <MenuItem Header="删除" Click="OnDeleteSelected" />
              </ContextMenu>
            </dg:DataGrid.ContextMenu>
            <dg:DataGrid.Columns>
              <dg:DataGridTextColumn Header="内容" Binding="{Binding Content}" Width="*" />
              <dg:DataGridTextColumn Header="书籍" Binding="{Binding BookName}" Width="150" />
              <dg:DataGridTextColumn Header="作者" Binding="{Binding AuthorName}" Width="90" />
              <dg:DataGridTextColumn Header="页数" Binding="{Binding PageNumber}" Width="60" />
              <dg:DataGridTextColumn Header="日期" Binding="{Binding ClippingDate}" Width="130" />
            </dg:DataGrid.Columns>
          </dg:DataGrid>

          <dg:DataGrid IsVisible="{Binding ShowWordTable}" ItemsSource="{Binding LookupTable}"
                       SelectedItem="{Binding SelectedLookupTable, Mode=TwoWay}"
                       AutoGenerateColumns="False" IsReadOnly="True">
            <dg:DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="刷新" Click="OnRefreshCurrent" />
                <MenuItem Header="复制" Click="OnContextCopy" />
                <MenuItem Header="删除" Click="OnDeleteSelected" />
              </ContextMenu>
            </dg:DataGrid.ContextMenu>
            <dg:DataGrid.Columns>
              <dg:DataGridTextColumn Header="生词" Binding="{Binding Word}" Width="130" />
              <dg:DataGridTextColumn Header="词干" Binding="{Binding Stem}" Width="110" />
              <dg:DataGridTextColumn Header="词频" Binding="{Binding Frequency}" Width="60" />
              <dg:DataGridTextColumn Header="内容" Binding="{Binding Usage}" Width="*" />
              <dg:DataGridTextColumn Header="书籍" Binding="{Binding Title}" Width="130" />
              <dg:DataGridTextColumn Header="时间" Binding="{Binding Timestamp}" Width="130" />
            </dg:DataGrid.Columns>
          </dg:DataGrid>

        </Grid>
      </Grid>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns" Width="3" />

      <Border Grid.Column="4" Background="{DynamicResource KmSurfaceBrush}"
              BorderBrush="{DynamicResource KmBorderBrush}" BorderThickness="1,0,0,0">
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="复制" Click="OnContextCopy" />
            <MenuItem Header="全选" Click="OnContextCopy" />
          </ContextMenu>
        </Border.ContextMenu>
        <Grid RowDefinitions="Auto,*,Auto" Margin="16,14">

          <StackPanel Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Spacing="6" IsVisible="{Binding Detail.HasNoSelection}">
            <TextBlock Text="未选中内容" Foreground="{DynamicResource KmTextSecondaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Classes="tt" Text="从列表或表格中选择一条记录" HorizontalAlignment="Center" />
          </StackPanel>

          <StackPanel Grid.Row="0" IsVisible="{Binding Detail.HasSelection}">
            <Grid ColumnDefinitions="Auto,*">
              <Border Grid.Column="0" Classes="chip" IsVisible="{Binding Detail.HasType}"
                      Classes.highlight="{Binding Detail.IsHighlight}" Classes.note="{Binding Detail.IsNote}"
                      Classes.bookmark="{Binding Detail.IsBookmark}" Classes.cut="{Binding Detail.IsCut}"
                      HorizontalAlignment="Left">
                <TextBlock Text="{Binding Detail.TypeText}" />
              </Border>
              <TextBlock Grid.Column="1" Classes="tt" Text="{Binding Detail.Time}" HorizontalAlignment="Right"
                         IsVisible="{Binding Detail.HasTime}" />
            </Grid>
            <TextBlock Classes="title" Text="{Binding Detail.Title}" Margin="0,12,0,0" TextWrapping="Wrap" />
            <TextBlock Classes="ts" Text="{Binding Detail.Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap" />
          </StackPanel>

          <ScrollViewer Grid.Row="1" Margin="0,14,0,0" IsVisible="{Binding Detail.HasSelection}">
            <StackPanel>
              <Rectangle Height="1" Fill="{DynamicResource KmBorderBrush}" Margin="0,0,0,14" />

              <StackPanel IsVisible="{Binding Detail.HasQuote}">
                <TextBlock Classes="tt" Text="{Binding Detail.QuoteLabel}" />
                <Border BorderBrush="{DynamicResource KmBorderStrongBrush}" BorderThickness="2,0,0,0"
                        Padding="11,0,0,0" Margin="0,7,0,0">
                  <SelectableTextBlock Text="{Binding Detail.Quote}" TextWrapping="Wrap" FontSize="13"
                                       LineHeight="23" Foreground="{DynamicResource KmTextSecondaryBrush}" />
                </Border>
              </StackPanel>

              <StackPanel IsVisible="{Binding Detail.HasNote}" Margin="0,16,0,0">
                <TextBlock Classes="tt" Text="{Binding Detail.NoteLabel}" />
                <SelectableTextBlock Text="{Binding Detail.Note}" TextWrapping="Wrap" FontSize="14"
                                     LineHeight="25" Margin="0,7,0,0" />
              </StackPanel>

              <SelectableTextBlock IsVisible="{Binding Detail.HasBody}" Text="{Binding Detail.Body}"
                                   TextWrapping="Wrap" FontSize="14" LineHeight="25" />
            </StackPanel>
          </ScrollViewer>

          <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,14,0,0"
                IsVisible="{Binding Detail.HasSelection}">
            <Button Grid.Column="0" Classes="primary" Content="复制" Click="OnCopyDetail" />
            <Button Grid.Column="1" Classes="ghost seg" Content="导出" Margin="8,0,0,0" Click="OnMenuExportMarkdown" />
            <Button Grid.Column="3" Classes="danger" Content="删除" Click="OnDeleteSelected" />
          </Grid>

        </Grid>
      </Border>
    </Grid>

  </DockPanel>
</Window>
