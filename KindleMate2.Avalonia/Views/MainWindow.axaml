<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:KindleMate2.Avalonia.ViewModels"
        xmlns:models="using:KindleMate2.Avalonia.Models"
        xmlns:dg="using:Avalonia.Controls"
        xmlns:shared="using:KindleMate2.Shared"
        x:Class="KindleMate2.Avalonia.Views.MainWindow"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="780"
        x:DataType="vm:MainWindowViewModel"
        Title="Kindle Mate 2"
        Icon="/Assets/bookmark.ico"
        Width="1200" Height="780" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Opened="OnOpened">

  <Window.Styles>
    <Style Selector="TextBox.inline">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox.flat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Button.seg">
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="11,3" />
      <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Padding" Value="6" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="MinWidth" Value="30" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <Border DockPanel.Dock="Top" Height="32" Background="{DynamicResource KmChromeBrush}"
            BorderBrush="{DynamicResource KmBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*" Margin="12,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <!-- 品牌标记:用真实图标。原为 13×13 纯色占位方块 —— 图标自带透明留白,
               13px 下细节会糊掉(红色书签仅约 2px 宽),故放大到 16px 保住可辨识度。 -->
          <Image Width="16" Height="16" Source="/Assets/bookmark.png"
                 Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock Text="Kindle Mate 2" FontSize="12" VerticalAlignment="Center"
                     Foreground="{DynamicResource KmTextSecondaryBrush}" Margin="0,0,8,0" />
          <Menu VerticalAlignment="Center">
            <MenuItem Header="{x:Static shared:Strings.Ui_Menu_File}">
              <MenuItem Header="{x:Static shared:Strings.Refresh}" Click="OnMenuRefresh" />
              <MenuItem Header="{x:Static shared:Strings.Ui_Menu_Statistics}" Click="OnMenuStatistics" />
              <Separator />
              <MenuItem Header="{x:Static shared:Strings.Restart}" Click="OnMenuRestart" />
              <MenuItem Header="{x:Static shared:Strings.Exit}" Click="OnMenuExit" />
            </MenuItem>
            <MenuItem Header="{x:Static shared:Strings.Ui_Menu_Manage}">
              <MenuItem Header="{x:Static shared:Strings.Ui_Menu_ImportClippings}" Click="OnMenuImportClippings" />
              <MenuItem Header="{x:Static shared:Strings.Ui_Menu_ImportWords}" Click="OnMenuImportVocab" />
              <MenuItem Header="{x:Static shared:Strings.Ui_Menu_ImportKmDatabase}" Click="OnMenuImportKmDatabase" />
              <!-- 本程序自己的库格式(KM2.dat),把别处一份库合并进来;菜单上单列是为了让来源一目了然 -->
              <MenuItem Header="{x:Static shared:Strings.Ui_Menu_ImportKm2Database}" Click="OnMenuImportKm2Database" />
              <MenuItem Header="{x:Static shared:Strings.Ui_Menu_ImportKmateDatabase}" Click="OnMenuImportKmateDatabase" />
              <!-- 原版此项(menuSyncFromKindle)就是 Visible=false,真正对用户可见的入口
                   是菜单栏那个「Kindle设备已连接」按钮 —— 故这里保持隐藏,不要"顺手打开"。 -->
              <MenuItem Header="{x:Static shared:Strings.Ui_Menu_ImportFromDevice}" Click="OnMenuImportFromDevice" IsVisible="False" />
              <!-- 设备未连接时置灰。灰掉的项点不动,所以原因靠悬停提示给
                   (ToolTip.ShowOnDisabled 必须显式打开,默认不给禁用控件弹提示)。 -->
              <MenuItem Header="{x:Static shared:Strings.Ui_Menu_SyncToDevice}" Click="OnMenuSyncToDevice"
                        IsEnabled="{Binding IsDeviceConnected}"
                        ToolTip.Tip="{Binding SyncToDeviceHint}"
                        ToolTip.ShowOnDisabled="True" />
              <Separator />
              <MenuItem Header="{x:Static shared:Strings.Ui_Menu_ExportMarkdown}" Click="OnMenuExportMarkdown" />
              <!-- 2026-09-22 由「清理数据库」+「清洗标注文本」合并而来:两者本是同一条流水线
                   (导入路径已经在跑 清洗 → 清理),拆成两个只差一个字的菜单项反而让人分不清该点哪个。 -->
              <MenuItem Header="{x:Static shared:Strings.Ui_Menu_MaintainDatabase}" Click="OnMenuMaintainDatabase" />
              <MenuItem Header="{x:Static shared:Strings.Ui_Menu_RebuildDatabase}" Click="OnMenuRebuildDb" />
              <MenuItem Header="{x:Static shared:Strings.Backup}" Click="OnMenuBackup" />
              <MenuItem Header="{x:Static shared:Strings.Ui_Menu_ClearData}" Click="OnMenuDeleteAll" />
              <!-- 仅当正在查看回收站时可用(原版无此功能) -->
              <MenuItem Header="{x:Static shared:Strings.Ui_Menu_PurgeRecycleBin}" Click="OnPurgeRecycleBin"
                        IsVisible="{Binding IsRecycleBinView}" />
            </MenuItem>
            <MenuItem Header="{x:Static shared:Strings.Ui_Menu_Help}">
              <MenuItem Header="{x:Static shared:Strings.Ui_Update_Check}" Click="OnMenuCheckUpdates" />
              <MenuItem Header="{x:Static shared:Strings.About}" Click="OnMenuAbout" />
              <MenuItem Header="{x:Static shared:Strings.Ui_Menu_Github}" Click="OnMenuGithub" />
            </MenuItem>

            <!--
              对齐原版 menuKindle:菜单栏里的一等项、带手机图标,文案「Kindle设备已连接」。
              原版行为:Visible = isConnected(设备连上才出现)、点击即执行「从设备导入」、
              悬停变手型光标。位置也在「帮助」之后。
            -->
            <MenuItem Header="{x:Static shared:Strings.Kindle_Device_Connected}"
                      Click="OnMenuKindleConnected"
                      IsVisible="{Binding IsDeviceConnected}"
                      Cursor="Hand">
              <MenuItem.Icon>
                <Image Width="16" Height="16" Source="/Assets/mobile-phone-with-arrow.png"
                       Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />
              </MenuItem.Icon>
            </MenuItem>
          </Menu>
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Height="48" Background="{DynamicResource KmSurfaceBrush}"
            BorderBrush="{DynamicResource KmBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" Margin="12,0" VerticalAlignment="Center">
        <Border Grid.Column="0" Height="30" MaxWidth="520" HorizontalAlignment="Left"
                Background="{DynamicResource KmRaisedBrush}" BorderBrush="{DynamicResource KmBorderStrongBrush}"
                BorderThickness="0.5" CornerRadius="7" Padding="9,0">
          <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <Path Grid.Column="0" Width="14" Height="14" Stretch="None"
                  Stroke="{DynamicResource KmTextTertiaryBrush}" StrokeThickness="1.5"
                  Data="M6.5 2A4.5 4.5 0 1 1 6.5 11A4.5 4.5 0 0 1 6.5 2Z M9.8 9.8L13.5 13.5" />
            <TextBox Grid.Column="1" Classes="inline" Text="{Binding SearchText, Mode=TwoWay}"
                     PlaceholderText="{x:Static shared:Strings.Ui_Search_Placeholder}" />
            <ComboBox Grid.Column="2" Classes="flat" Width="74"
                      ItemsSource="{Binding SearchTypes}" SelectedItem="{Binding SearchType, Mode=TwoWay}" />
          </Grid>
        </Border>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Background="{DynamicResource KmRaisedBrush}" BorderBrush="{DynamicResource KmBorderBrush}"
                  BorderThickness="0.5" CornerRadius="6" Padding="2">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Classes="ghost seg" Classes.active="{Binding IsListMode}"
                      Content="{x:Static shared:Strings.Ui_View_List}" Click="OnShowList" />
              <Button Classes="ghost seg" Classes.active="{Binding IsTableMode}"
                      Content="{x:Static shared:Strings.Ui_View_Table}" Click="OnShowTable" />
            </StackPanel>
          </Border>

          <Button Classes="ghost icon" Click="OnToggleTheme"
                  ToolTip.Tip="{x:Static shared:Strings.Ui_Tip_ToggleTheme}">
            <Path Width="14" Height="14" Stretch="None" Stroke="{DynamicResource KmTextSecondaryBrush}" StrokeThickness="1.3"
                  Data="M12.5 9.8A5.5 5.5 0 0 1 6.2 3.5A5.5 5.5 0 1 0 12.5 9.8Z" />
          </Button>

          <Button Classes="ghost icon" ToolTip.Tip="{x:Static shared:Strings.Ui_Tip_Language}">
            <Path Width="14" Height="14" Stretch="None" Stroke="{DynamicResource KmAccentBrush}" StrokeThickness="1.3"
                  Data="M8 2.5A5.5 5.5 0 1 1 8 13.5A5.5 5.5 0 0 1 8 2.5Z M2.5 8H13.5 M8 2.5C9.9 4.6 9.9 11.4 8 13.5 M8 2.5C6.1 4.6 6.1 11.4 8 13.5" />
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="{x:Static shared:Strings.Ui_Lang_Hans}" Click="OnLanguageHans" />
                <MenuItem Header="{x:Static shared:Strings.Ui_Lang_Hant}" Click="OnLanguageHant" />
                <MenuItem Header="{x:Static shared:Strings.Ui_Lang_En}" Click="OnLanguageEn" />
                <MenuItem Header="{x:Static shared:Strings.Ui_Lang_Auto}" Click="OnLanguageAuto" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Height="28" Background="{DynamicResource KmSurfaceBrush}"
            BorderBrush="{DynamicResource KmBorderBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="12,0" VerticalAlignment="Center">
        <TextBlock Grid.Column="0" Classes="tt" Text="{Binding StatusLeft}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="tt" Text="{Binding StatusText}" VerticalAlignment="Center" Margin="14,0,0,0" />

        <!--
          进行中的操作:阶段文案 + 数量明细 + 进度条。
          能算出比例(如导入按「已处理/总条数」)就画确定进度,否则自动退化为不确定态;
          操作结束后整组隐藏,不占视觉。
        -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                    IsVisible="{Binding IsProgressVisible}">
          <ProgressBar Width="120" Height="6" VerticalAlignment="Center"
                       Minimum="0" Maximum="100"
                       Value="{Binding ProgressValue}"
                       IsIndeterminate="{Binding IsProgressIndeterminate}" />
          <TextBlock Classes="tt" Text="{Binding ProgressStageText}" VerticalAlignment="Center"
                     Foreground="{DynamicResource KmAccentBrush}" />
          <TextBlock Classes="ts" Text="{Binding ProgressDetailText}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="14,0,0,0">
          <!--
            有可用更新时才出现(检查更新由「帮助 → 检查更新」触发)。
            点击后下载、交给替换脚本并自动重启 —— 见 MainWindowViewModel.DownloadAndApplyUpdateAsync。
          -->
          <Button Classes="ghost" Content="{Binding UpdateButtonText}" Click="OnUpdateClick"
                  IsVisible="{Binding IsUpdateAvailable}" Cursor="Hand" Margin="0,0,8,0" />
          <!--
            这一排的每个孩子都必须自己声明 VerticalAlignment="Center"，不能靠默认值。
            默认是 Stretch：更新按钮的基线样式带 MinHeight=28(见 App.axaml)，有更新时它把整排
            撑到 28px，而 TextBlock/Ellipse 于是被拉伸到这个高度 —— 文字画在自己的**顶部**，
            比左侧居中的「有新版本 …」高出约 7px(2026-09-22 用户报的错位)。
            没有更新按钮时整排只有一行文字高，拉伸等于自身高度，缺陷不显形 ⇒ 只有"有更新时"才现形。
          -->
          <Ellipse Width="6" Height="6" Fill="{DynamicResource KmTextTertiaryBrush}" VerticalAlignment="Center" />
          <TextBlock Classes="tt" Text="{Binding DeviceStatus}" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid ColumnDefinitions="236,3,*,3,330">

      <Border Grid.Column="0" Background="{DynamicResource KmSurfaceBrush}">
        <DockPanel Margin="8,10">
          <Border DockPanel.Dock="Top" Background="{DynamicResource KmRaisedBrush}" CornerRadius="7" Padding="2">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="2">
              <Button Grid.Column="0" Classes="ghost seg" Classes.active="{Binding IsClipDomain}"
                      Content="{x:Static shared:Strings.Clippings}" HorizontalAlignment="Stretch" Click="OnSelectClipDomain" />
              <Button Grid.Column="1" Classes="ghost seg" Classes.active="{Binding IsWordDomain}"
                      Content="{x:Static shared:Strings.Ui_Domain_Vocab}" HorizontalAlignment="Stretch" Click="OnSelectWordDomain" />
            </Grid>
          </Border>

          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="4,14,4,6">
            <TextBlock Grid.Column="0" Classes="tt" Text="{Binding NavSectionTitle}" />
            <TextBlock Grid.Column="1" Classes="tt" Text="{Binding NavSectionCount}" />
          </Grid>

          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource KmBorderBrush}" BorderThickness="0,1,0,0"
                  Padding="8,9" Margin="0,8,0,0" Cursor="Hand" Tapped="OnOpenRecycleBin">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{x:Static shared:Strings.Ui_Nav_RecycleBin}" FontSize="12"
                         Foreground="{DynamicResource KmTextSecondaryBrush}" />
              <TextBlock Grid.Column="1" Classes="ts" Text="{Binding DeletedCount}" />
            </Grid>
          </Border>

          <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                   KeyDown="OnNavKeyDown">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{x:Static shared:Strings.Refresh}" Click="OnRefreshCurrent" />
                <!-- 「导出」「重命名书籍」都是对**某本书**做的动作 ⇒ 生词域里收起。
                     不收起的话点下去会拿"那个词"当书名去找同名书 ——
                     重命名甚至会真的改到数据。可用性同时依赖"哪个域"与"选中哪个节点",
                     换域时由 VM 发通知(见 ApplyFilter),否则菜单会停在初始状态。 -->
                <MenuItem Header="{x:Static shared:Strings.Ui_Action_Export}" Click="OnExportCurrent"
                          IsVisible="{Binding CanExportCurrent}" />
                <MenuItem Header="{x:Static shared:Strings.Ui_Op_RenameBook}" Click="OnRenameCurrent"
                          IsVisible="{Binding CanRenameCurrentBook}" />
                <!-- 注意:这里删的是**左栏节点**(某本书 / 全部标注 / 全部生词 / 某个词),
                     对应原版 MenuBooksDelete_Click → DeleteNodes();不要改成删列表行的那套。 -->
                <MenuItem Header="{x:Static shared:Strings.Delete}" Click="OnDeleteNavNode" />
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:NavItem">
                <Grid ColumnDefinitions="3,*,Auto" ColumnSpacing="8">
                  <Border Grid.Column="0" Classes="kbar" Width="3" CornerRadius="2" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Classes="ts" Text="{Binding CountText}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Width="3" />

      <Grid Grid.Column="2" RowDefinitions="38,*">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Margin="14,0" VerticalAlignment="Center">
          <TextBlock Grid.Column="0" Text="{Binding HeaderTitle}" FontSize="12" FontWeight="SemiBold"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1" Classes="tt" Text="{Binding HeaderSubtitle}" Margin="8,0,0,0"
                     VerticalAlignment="Center" />
          <Button Grid.Column="3" Classes="ghost seg" Content="{Binding SortLabel}" Click="OnToggleSort" />
        </Grid>

        <Grid Grid.Row="1">

          <ListBox IsVisible="{Binding ShowList}" ItemsSource="{Binding Items}"
                   SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                   DoubleTapped="OnEditClipping">
            <!-- 分组标题行(生词域的「N 条查询」/「N 条标注」)**不能被选中** ——
                 它不是一条记录,没有可删/可编辑/可复制的对象,选中它只会把右栏清空。
                 VM 侧只保证「不算可操作」(HasSelectedItem)与「程序自动选中时跳过它」,
                 这两条都管不住鼠标:标题行照样能被点出高亮,看着就像选中了一条数据。
                 这里把它的 ListBoxItem 置为**不可用**:禁用容器不吃点击、也不给悬停高亮,
                 键盘上下切换同样会跳过它 —— 正是小标题该有的样子。
                 禁用会不会把标题弄灰?不会。Fluent 的 ListBoxItem ControlTheme 在 :disabled 下
                 只下发一个 Foreground(落在 PART_ContentPresenter 上),而标题文字自带 .ts 的
                 Foreground(样式值优先于继承值),外观一字不变 ⇒ 不必再压任何东西回去。
                 注意 x:DataType 不能省:控件内联 <Style> 不继承外层 DataTemplate 的 x:DataType,
                 缺了它这条绑定就解析不到 ListItem.IsSectionHeader(编译期直接报 AVLN2000)。 -->
            <ListBox.Styles>
              <Style Selector="ListBoxItem" x:DataType="models:ListItem">
                <Setter Property="IsEnabled" Value="{Binding !IsSectionHeader}" />
              </Style>
            </ListBox.Styles>
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{x:Static shared:Strings.Refresh}" Click="OnRefreshCurrent" />
                <MenuItem Header="{x:Static shared:Strings.Copy}" Click="OnContextCopy" />
                <!-- 分享为图片:只作用于**选中那一行**;回收站视图下收起(那里的行是临时拼的) -->
                <MenuItem Header="{x:Static shared:Strings.Ui_Op_ShareImage}" Click="OnShareSelectedClipping"
                          IsVisible="{Binding CanShareSelectedClipping}" />
                <!-- 这两条作用于**选中那一行**,而不是左栏节点:左栏停在「全部标注」或搜索结果里时,
                     行所属的书与节点根本不是一回事(沿用节点名会改错书)。
                     回收站视图下都收起 —— 那里的行是从原始行临时拼的(键已不在 clippings 里),改不动。 -->
                <MenuItem Header="{x:Static shared:Strings.Ui_Op_RenameBook}" Click="OnRenameSelectedBook"
                          IsVisible="{Binding CanRenameSelectedItemBook}" />
                <MenuItem Header="{x:Static shared:Strings.Edit_Clippings}" Click="OnEditSelectedClipping"
                          IsVisible="{Binding CanEditSelectedClipping}" />
                <MenuItem Header="{x:Static shared:Strings.Delete}" Click="OnDeleteSelected"
                          IsVisible="{Binding !IsRecycleBinView}" />
                <MenuItem Header="{x:Static shared:Strings.Restore}" Click="OnRestoreFromRecycleBin"
                          IsVisible="{Binding IsRecycleBinView}" />
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:ListItem">
                <!-- 分组标题行(生词域:查询 / 标注)。VM 把它作为**独立一行**插进 Items
                     (见 BuildWordDomainItems),这里只负责把那一行画成小标题。
                     用第 0 个 Auto 行承载:非标题行时它不可见 ⇒ 高度收成 0,普通行布局一字不变。 -->
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="3,*" ColumnSpacing="10">
                  <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Classes="ts" Text="{Binding SectionTitle}"
                             IsVisible="{Binding IsSectionHeader}" FontWeight="SemiBold" Margin="0,10,0,2" />
                  <Border Grid.Row="1" Grid.Column="0" Classes="kbar" Width="3" CornerRadius="2" />
                  <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5">
                    <TextBlock Text="{Binding Primary}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                      <!-- 书名占 * 列并**由它负责省略**。刻意不套横向 StackPanel:
                           横向 StackPanel 按**无限宽**测量子元素,TextTrimming 永不触发,
                           长书名会直接溢出、把类型标签与时间压掉(2026-09-22 修)。
                           悬停看完整书名 —— 省略掉的信息得有个地方找回来。
                           列间距用 Margin 而不是 ColumnSpacing:被 IsVisible 收起的列
                           不该再占一份间距。 -->
                      <TextBlock Grid.Column="0" Classes="ts" Text="{Binding Book}" IsVisible="{Binding HasBook}"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                 Margin="0,0,7,0" ToolTip.Tip="{Binding Book}" />
                      <TextBlock Grid.Column="1" Classes="ts" Text="{Binding MetaTail}" IsVisible="{Binding HasMetaTail}"
                                 VerticalAlignment="Center" Margin="0,0,7,0" />
                      <Border Grid.Column="2" Classes="chip" IsVisible="{Binding HasType}"
                              Classes.highlight="{Binding IsHighlight}" Classes.note="{Binding IsNote}"
                              Classes.bookmark="{Binding IsBookmark}" Classes.cut="{Binding IsCut}"
                              VerticalAlignment="Center" Margin="0,0,7,0">
                        <TextBlock Text="{Binding TypeText}" />
                      </Border>
                      <TextBlock Grid.Column="3" Classes="tt" Text="{Binding Time}"
                                 IsVisible="{Binding HasTime}" VerticalAlignment="Center" />
                    </Grid>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <dg:DataGrid x:Name="ClipTableGrid" IsVisible="{Binding ShowClipTable}" ItemsSource="{Binding ClipTable}"
                       SelectedItem="{Binding SelectedClipTable, Mode=TwoWay}"
                       AutoGenerateColumns="False" IsReadOnly="True"
                       DoubleTapped="OnEditClipping">
            <dg:DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{x:Static shared:Strings.Refresh}" Click="OnRefreshCurrent" />
                <MenuItem Header="{x:Static shared:Strings.Copy}" Click="OnContextCopy" />
                <MenuItem Header="{x:Static shared:Strings.Delete}" Click="OnDeleteSelected" />
              </ContextMenu>
            </dg:DataGrid.ContextMenu>
            <dg:DataGrid.Columns>
              <dg:DataGridTextColumn Header="{x:Static shared:Strings.Content}" Binding="{Binding Content}" Width="*" />
              <!-- 「书籍 / 作者」两列在**整列同值**时收起(左栏选中某本书时就是这样)。
                   可见性由代码后置同步,不写成 Binding:DataGridColumn 不是控件、不在可视树上,
                   拿不到 DataContext,列上的绑定不会生效;也不能用 x:Name(生成不出字段)。
                   故用 Tag 定位(见 MainWindow.axaml.cs 的 ApplyTableColumnVisibility)。 -->
              <dg:DataGridTextColumn Tag="book" Header="{x:Static shared:Strings.Books}" Binding="{Binding BookName}" Width="150" />
              <dg:DataGridTextColumn Tag="author" Header="{x:Static shared:Strings.Author}" Binding="{Binding AuthorName}" Width="90" />
              <dg:DataGridTextColumn Header="{x:Static shared:Strings.Page}" Binding="{Binding PageNumber}" Width="60" />
              <dg:DataGridTextColumn Header="{x:Static shared:Strings.Ui_Col_Date}" Binding="{Binding ClippingDate}" Width="130" />
            </dg:DataGrid.Columns>
          </dg:DataGrid>

          <dg:DataGrid x:Name="WordTableGrid" IsVisible="{Binding ShowWordTable}" ItemsSource="{Binding LookupTable}"
                       SelectedItem="{Binding SelectedLookupTable, Mode=TwoWay}"
                       AutoGenerateColumns="False" IsReadOnly="True">
            <dg:DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{x:Static shared:Strings.Refresh}" Click="OnRefreshCurrent" />
                <MenuItem Header="{x:Static shared:Strings.Copy}" Click="OnContextCopy" />
                <MenuItem Header="{x:Static shared:Strings.Delete}" Click="OnDeleteSelected" />
              </ContextMenu>
            </dg:DataGrid.ContextMenu>
            <dg:DataGrid.Columns>
              <!-- 选中某个生词时整列同值 ⇒ 收起(同「书籍 / 作者」,理由见上面那张表的注释)。
                   「词干」与「生词」分开判:跨生词搜索可能命中同一词干的多个词形。 -->
              <dg:DataGridTextColumn Tag="word" Header="{x:Static shared:Strings.Ui_Col_Word}" Binding="{Binding Word}" Width="130" />
              <dg:DataGridTextColumn Tag="stem" Header="{x:Static shared:Strings.Stem}" Binding="{Binding Stem}" Width="110" />
              <dg:DataGridTextColumn Header="{x:Static shared:Strings.Frequency}" Binding="{Binding Frequency}" Width="60" />
              <dg:DataGridTextColumn Header="{x:Static shared:Strings.Content}" Binding="{Binding Usage}" Width="*" />
              <dg:DataGridTextColumn Header="{x:Static shared:Strings.Books}" Binding="{Binding Title}" Width="130" />
              <dg:DataGridTextColumn Header="{x:Static shared:Strings.Time}" Binding="{Binding Timestamp}" Width="130" />
            </dg:DataGrid.Columns>
          </dg:DataGrid>

        </Grid>
      </Grid>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns" Width="3" />

      <Border Grid.Column="4" Background="{DynamicResource KmSurfaceBrush}"
              BorderBrush="{DynamicResource KmBorderBrush}" BorderThickness="1,0,0,0">
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{x:Static shared:Strings.Copy}" Click="OnContextCopy" />
            <MenuItem Header="{x:Static shared:Strings.Ui_Op_ShareImage}" Click="OnShareSelectedClipping"
                      IsVisible="{Binding CanShareSelectedClipping}" />
            <!-- 详情面板的右键菜单覆盖整块面板(书名、正文、标签都能触发)——
                 这正是"在详情的书名上重命名、在详情的标注内容上编辑"的实现方式。
                 注意:正文那三个 SelectableTextBlock 必须显式清掉主题自带的 ContextFlyout,
                 否则它会抢在父级 ContextMenu 之前弹出来(见下面的 ContextFlyout="{x:Null}")。 -->
            <MenuItem Header="{x:Static shared:Strings.Ui_Op_RenameBook}" Click="OnRenameSelectedBook"
                      IsVisible="{Binding CanRenameSelectedItemBook}" />
            <MenuItem Header="{x:Static shared:Strings.Edit_Clippings}" Click="OnEditSelectedClipping"
                      IsVisible="{Binding CanEditSelectedClipping}" />
          </ContextMenu>
        </Border.ContextMenu>
        <Grid RowDefinitions="Auto,*,Auto" Margin="16,14">

          <StackPanel Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Spacing="6" IsVisible="{Binding Detail.HasNoSelection}">
            <TextBlock Text="{x:Static shared:Strings.Ui_Detail_Empty}"
                       Foreground="{DynamicResource KmTextSecondaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Classes="tt" Text="{x:Static shared:Strings.Ui_Detail_EmptyHint}" HorizontalAlignment="Center" />
          </StackPanel>

          <StackPanel Grid.Row="0" IsVisible="{Binding Detail.HasSelection}">
            <Grid ColumnDefinitions="Auto,*">
              <Border Grid.Column="0" Classes="chip" IsVisible="{Binding Detail.HasType}"
                      Classes.highlight="{Binding Detail.IsHighlight}" Classes.note="{Binding Detail.IsNote}"
                      Classes.bookmark="{Binding Detail.IsBookmark}" Classes.cut="{Binding Detail.IsCut}"
                      HorizontalAlignment="Left">
                <TextBlock Text="{Binding Detail.TypeText}" />
              </Border>
              <TextBlock Grid.Column="1" Classes="tt" Text="{Binding Detail.Time}" HorizontalAlignment="Right"
                         IsVisible="{Binding Detail.HasTime}" />
            </Grid>
            <TextBlock Classes="title" Text="{Binding Detail.Title}" Margin="0,12,0,0" TextWrapping="Wrap" />
            <TextBlock Classes="ts" Text="{Binding Detail.Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap" />
          </StackPanel>

          <ScrollViewer x:Name="DetailContentScroll" Grid.Row="1" Margin="0,14,0,0"
                        IsVisible="{Binding Detail.HasSelection}">
            <StackPanel>
              <Rectangle Height="1" Fill="{DynamicResource KmBorderBrush}" Margin="0,0,0,14" />

              <!-- 下面三个 SelectableTextBlock 都显式清掉 ContextFlyout:
                   Avalonia 的 FluentTheme 给 SelectableTextBlock 内置了一个只含 Copy 的 ContextFlyout,
                   而 ContextFlyout 优先于父级的 ContextMenu ⇒ 不清掉的话,
                   在正文上右键永远弹内置那个,详情面板的菜单(复制/重命名书籍/编辑标注)根本看不到。 -->
              <StackPanel IsVisible="{Binding Detail.HasQuote}">
                <TextBlock Classes="tt" Text="{Binding Detail.QuoteLabel}" />
                <Border BorderBrush="{DynamicResource KmBorderStrongBrush}" BorderThickness="2,0,0,0"
                        Padding="11,0,0,0" Margin="0,7,0,0">
                  <SelectableTextBlock Text="{Binding Detail.Quote}" TextWrapping="Wrap" FontSize="13"
                                       LineHeight="23" Foreground="{DynamicResource KmTextSecondaryBrush}"
                                       ContextFlyout="{x:Null}" />
                </Border>
              </StackPanel>

              <StackPanel IsVisible="{Binding Detail.HasNote}" Margin="0,16,0,0">
                <TextBlock Classes="tt" Text="{Binding Detail.NoteLabel}" />
                <SelectableTextBlock Text="{Binding Detail.Note}" TextWrapping="Wrap" FontSize="14"
                                     LineHeight="25" Margin="0,7,0,0"
                                     ContextFlyout="{x:Null}" />
              </StackPanel>

              <!--
                在线释义(生词详情)。**拿不到就不显示**:没联网 / 接口没这个词 / 解析失败时
                HasDefinition 都是 false,整块收起 —— 连"查询失败"都不出现,与「检查更新」
                同一条口径(连不上外网不是错误,不该弹提示)。
                放在「用法」列表(body)之前:先给词典释义,再给了 Kindle 记下的原句。
                边距只加在**本块的下方** —— 收起时(IsVisible=false)不参与布局,
                body 的上下间距保持原样,不给没有释义的情况留空档。
              -->
              <StackPanel IsVisible="{Binding Detail.HasDefinition}" Margin="0,0,0,16">
                <TextBlock Classes="tt" Text="{Binding Detail.DefinitionLabel}" />
                <SelectableTextBlock Text="{Binding Detail.Definition}" TextWrapping="Wrap" FontSize="14"
                                     LineHeight="24" Margin="0,7,0,0"
                                     ContextFlyout="{x:Null}" />
              </StackPanel>

              <SelectableTextBlock IsVisible="{Binding Detail.HasBody}" Text="{Binding Detail.Body}"
                                   TextWrapping="Wrap" FontSize="14" LineHeight="25"
                                   ContextFlyout="{x:Null}" />
            </StackPanel>
          </ScrollViewer>

          <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,14,0,0"
                IsVisible="{Binding Detail.HasSelection}">
            <Button Grid.Column="0" Classes="primary" Content="{x:Static shared:Strings.Copy}" Click="OnCopyDetail" />
            <Button Grid.Column="1" Classes="ghost seg" Content="{x:Static shared:Strings.Ui_Action_Export}"
                    Margin="8,0,0,0" Click="OnMenuExportMarkdown" />
            <Button Grid.Column="2" Classes="ghost seg" Content="{x:Static shared:Strings.Ui_Op_ShareImage}"
                    Margin="8,0,0,0" Click="OnShareSelectedClipping"
                    IsVisible="{Binding CanShareSelectedClipping}" />
            <Button Grid.Column="4" Classes="danger" Content="{x:Static shared:Strings.Delete}" Click="OnDeleteSelected" />
          </Grid>

        </Grid>
      </Border>
    </Grid>

  </DockPanel>
</Window>
