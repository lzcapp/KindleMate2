<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:KindleMate2.Avalonia.ViewModels"
        xmlns:models="using:KindleMate2.Avalonia.Models"
        xmlns:dg="using:Avalonia.Controls"
        x:Class="KindleMate2.Avalonia.Views.MainWindow"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:DataType="vm:MainWindowViewModel"
        Title="Kindle Mate 2"
        Width="1280" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Opened="OnOpened">

  <DockPanel>

    <!-- 菜单栏(原 UI:文件/管理/帮助) -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="文件(_F)">
        <MenuItem Header="刷新" Click="OnMenuRefresh"/>
        <MenuItem Header="统计" Click="OnMenuStatistics"/>
        <Separator/>
        <MenuItem Header="重启" Click="OnMenuRestart"/>
        <MenuItem Header="退出" Click="OnMenuExit"/>
      </MenuItem>
      <MenuItem Header="管理(_M)">
        <MenuItem Header="导入Kindle标注" Click="OnMenuImportClippings"/>
        <MenuItem Header="导入Kindle生词本" Click="OnMenuImportVocab"/>
        <MenuItem Header="导入Kindle Mate数据库" Click="OnMenuImportKmDatabase"/>
        <MenuItem Header="导入KMate数据库" Click="OnMenuImportKmateDatabase"/>
        <MenuItem Header="从Kindle设备导入" Click="OnMenuImportFromDevice"/>
        <MenuItem Header="同步到Kindle设备" Click="OnMenuSyncToDevice"/>
        <Separator/>
        <MenuItem Header="导出为Markdown" Click="OnMenuExportMarkdown"/>
        <MenuItem Header="清理数据库" Click="OnMenuCleanDb"/>
        <MenuItem Header="重建数据库" Click="OnMenuRebuildDb"/>
        <MenuItem Header="备份" Click="OnMenuBackup"/>
        <MenuItem Header="清空数据" Click="OnMenuDeleteAll"/>
      </MenuItem>
      <MenuItem Header="帮助(_H)">
        <MenuItem Header="关于" Click="OnMenuAbout"/>
        <MenuItem Header="GitHub仓库" Click="OnMenuGithub"/>
        <MenuItem Header="语言">
          <MenuItem Header="简体中文"/>
          <MenuItem Header="繁体中文"/>
          <MenuItem Header="英文"/>
          <MenuItem Header="自动"/>
        </MenuItem>
      </MenuItem>
    </Menu>

    <!-- 工具栏(原 UI:左 全部▼+搜索框+🔍 | 右 🌐设备 + ☀主题) -->
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1" Padding="8,6">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="6" VerticalAlignment="Center">
        <ComboBox Grid.Column="0" Width="90"
                  ItemsSource="{Binding SearchTypes}"
                  SelectedItem="{Binding SearchType}"/>
        <TextBox Grid.Column="1" Width="220" Text="{Binding SearchText, Mode=TwoWay}"
                 PlaceholderText="搜索..."/>
        <Button Grid.Column="2" HorizontalAlignment="Left" Content="🔍" Width="32" Click="OnSearchClick"/>
        <TextBlock Grid.Column="3" Text="{Binding DeviceStatus}" VerticalAlignment="Center"
                   Margin="20,0,0,0" Opacity="0.75"/>
        <Button Grid.Column="4" Content="☀" Width="32" Click="OnToggleTheme"
                ToolTip.Tip="切换深/浅主题" Margin="6,0,0,0"/>
      </Grid>
    </Border>

    <!-- 状态栏(原 UI:底部 1 行) -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0" Padding="8,5" Background="{DynamicResource LayerFillColorDefaultBrush}">
      <TextBlock Text="{Binding StatusBarText}" FontSize="12" Opacity="0.75"
                 TextTrimming="CharacterEllipsis"/>
    </Border>

    <!-- 主区:底部 tab(标注/生词本)+ 内部左树右表 -->
    <TabControl DockPanel.Dock="Top" SelectionChanged="OnDomainTabChanged" Padding="6">
      <TabItem Header="标注">
        <Grid ColumnDefinitions="280,*" ColumnSpacing="8">
          <ListBox Grid.Column="0" ItemsSource="{Binding LeftItems}" SelectedItem="{Binding SelectedItem}"
                   SelectionMode="Single" Background="{DynamicResource LayerFillColorDefaultBrush}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="x:Object">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <CheckBox/>
                  <TextBlock Text="{Binding}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <dg:DataGrid Grid.Column="1" ItemsSource="{Binding Clippings}"
                       AutoGenerateColumns="False" IsReadOnly="True"
                       GridLinesVisibility="None" HeadersVisibility="Column"
                       Background="Transparent">
            <dg:DataGrid.Columns>
              <dg:DataGridTextColumn Header="内容" Binding="{Binding Content}" Width="*"/>
              <dg:DataGridTextColumn Header="书籍" Binding="{Binding BookName}" Width="160"/>
              <dg:DataGridTextColumn Header="作者" Binding="{Binding AuthorName}" Width="80"/>
              <dg:DataGridTextColumn Header="页数" Binding="{Binding PageNumber}" Width="60"/>
              <dg:DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="60"/>
              <dg:DataGridTextColumn Header="时间" Binding="{Binding ClippingDate}" Width="146"/>
            </dg:DataGrid.Columns>
          </dg:DataGrid>
        </Grid>
      </TabItem>
      <TabItem Header="生词本">
        <Grid ColumnDefinitions="280,*" ColumnSpacing="8">
          <ListBox Grid.Column="0" ItemsSource="{Binding LeftItems}" SelectedItem="{Binding SelectedItem}"
                   SelectionMode="Single" Background="{DynamicResource LayerFillColorDefaultBrush}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="x:Object">
                <TextBlock Text="{Binding}" FontSize="13" Padding="4,0"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <dg:DataGrid Grid.Column="1" ItemsSource="{Binding Lookups}"
                       AutoGenerateColumns="False" IsReadOnly="True"
                       GridLinesVisibility="None" HeadersVisibility="Column"
                       Background="Transparent">
            <dg:DataGrid.Columns>
              <dg:DataGridTextColumn Header="词" Binding="{Binding Word}" Width="160"/>
              <dg:DataGridTextColumn Header="例句 / 出处" Binding="{Binding Usage}" Width="*"/>
              <dg:DataGridTextColumn Header="书名" Binding="{Binding Title}" Width="160"/>
              <dg:DataGridTextColumn Header="时间" Binding="{Binding Timestamp}" Width="146"/>
            </dg:DataGrid.Columns>
          </dg:DataGrid>
        </Grid>
      </TabItem>
    </TabControl>

  </DockPanel>
</Window>
