<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:KindleMate2.Avalonia.ViewModels"
        xmlns:charts="using:KindleMate2.Avalonia.Charts"
        xmlns:shared="using:KindleMate2.Shared"
        x:Class="KindleMate2.Avalonia.Views.StatisticsWindow"
        mc:Ignorable="d" d:DesignWidth="940" d:DesignHeight="680"
        x:DataType="vm:StatisticsViewModel"
        Title="{x:Static shared:Strings.Ui_Menu_Statistics}"
        Icon="/Assets/bookmark.ico"
        Width="940" Height="680" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner">

  <DockPanel>

    <Border DockPanel.Dock="Top" Height="48" Background="{DynamicResource KmSurfaceBrush}"
            BorderBrush="{DynamicResource KmBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" Margin="16,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{x:Static shared:Strings.Ui_Menu_Statistics}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Classes="tt" Text="{Binding Source}" VerticalAlignment="Center"
                     MaxWidth="360" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Background="{DynamicResource KmRaisedBrush}" BorderBrush="{DynamicResource KmBorderBrush}"
                  BorderThickness="0.5" CornerRadius="6" Padding="2">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button x:Name="TabClippings" Classes="ghost seg" Content="{x:Static shared:Strings.Clippings}" Click="OnShowClippings" />
              <Button x:Name="TabVocabs" Classes="ghost seg" Content="{x:Static shared:Strings.Ui_Domain_Vocab}" Click="OnShowVocabs" />
            </StackPanel>
          </Border>
          <Button Classes="primary" Content="{x:Static shared:Strings.Ui_Stats_ExportImage}" Click="OnExportImage" />
          <Button Content="{x:Static shared:Strings.Ui_Action_Close}" Click="OnClose" />
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Height="32" Background="{DynamicResource KmSurfaceBrush}"
            BorderBrush="{DynamicResource KmBorderBrush}" BorderThickness="0,1,0,0">
      <TextBlock x:Name="SummaryText" Classes="tt" Margin="16,0" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" />
    </Border>

    <!--
      图表区(2026-09-17 改版,用户要求"统计图表更多样化")。
      形态与数据性质的对应关系:时间序列 → 折线;离散分类且项少 → 竖柱;排名且项多/标签长 → 横向条形;
      构成占比 → 环形;日期密度 → 热力图。
      色彩只用唯一强调色 #7B8CFF 及其透明度阶梯,不引入第二色系 —— 五种形态仍属同一视觉语言。
      所有图表共用同一套内边距(左右 6 / 上 16 / 下 20)、10.5pt 标签与 0.5px 参考线,新图不另起一套。
      布局:行1 = 趋势(跨两列) + 构成环形;行2 = 按小时 / 按星期 / 排名;行3 = 整幅宽的年历热力图。
      Grid 的 * 行吃掉窗口剩余空间(ChartControl.DrawCore 基于 Bounds,给多大画多大);
      所有图表都支持悬停显示数值(命中测试见 ChartControl.HitTest)。
    -->
    <Grid x:Name="ChartHost" Margin="16" RowDefinitions="*,*,0.8*,Auto" RowSpacing="14">

      <Grid Grid.Row="0" ColumnDefinitions="2*,*" ColumnSpacing="14">
        <Border Grid.Column="0" Background="{DynamicResource KmSurfaceBrush}" BorderBrush="{DynamicResource KmBorderBrush}"
                BorderThickness="0.5" CornerRadius="10" Padding="14,12">
          <Grid RowDefinitions="Auto,*" RowSpacing="8">
            <TextBlock Grid.Row="0" Text="{x:Static shared:Strings.Ui_Stats_ByDate}" FontSize="12" Foreground="{DynamicResource KmTextSecondaryBrush}" />
            <charts:ChartControl Grid.Row="1" x:Name="DateChart" Kind="Line"
                                 Accent="{DynamicResource KmAccentBrush}"
                                 Axis="{DynamicResource KmBorderBrush}"
                                 Label="{DynamicResource KmTextTertiaryBrush}" />
          </Grid>
        </Border>
        <Border Grid.Column="1" Background="{DynamicResource KmSurfaceBrush}" BorderBrush="{DynamicResource KmBorderBrush}"
                BorderThickness="0.5" CornerRadius="10" Padding="14,12">
          <Grid RowDefinitions="Auto,*" RowSpacing="8">
            <TextBlock Grid.Row="0" x:Name="CompositionTitle" FontSize="12" Foreground="{DynamicResource KmTextSecondaryBrush}" />
            <charts:ChartControl Grid.Row="1" x:Name="CompositionChart" Kind="Donut"
                                 Accent="{DynamicResource KmAccentBrush}"
                                 Axis="{DynamicResource KmBorderBrush}"
                                 Label="{DynamicResource KmTextTertiaryBrush}" />
          </Grid>
        </Border>
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="14">
        <Border Grid.Column="0" Background="{DynamicResource KmSurfaceBrush}" BorderBrush="{DynamicResource KmBorderBrush}"
                BorderThickness="0.5" CornerRadius="10" Padding="14,12">
          <Grid RowDefinitions="Auto,*" RowSpacing="8">
            <TextBlock Grid.Row="0" Text="{x:Static shared:Strings.Ui_Stats_ByHour}" FontSize="12" Foreground="{DynamicResource KmTextSecondaryBrush}" />
            <charts:ChartControl Grid.Row="1" x:Name="HourChart" Kind="Bar"
                                 Accent="{DynamicResource KmAccentBrush}"
                                 Axis="{DynamicResource KmBorderBrush}"
                                 Label="{DynamicResource KmTextTertiaryBrush}" />
          </Grid>
        </Border>
        <Border Grid.Column="1" Background="{DynamicResource KmSurfaceBrush}" BorderBrush="{DynamicResource KmBorderBrush}"
                BorderThickness="0.5" CornerRadius="10" Padding="14,12">
          <Grid RowDefinitions="Auto,*" RowSpacing="8">
            <TextBlock Grid.Row="0" Text="{x:Static shared:Strings.Ui_Stats_ByWeekday}" FontSize="12" Foreground="{DynamicResource KmTextSecondaryBrush}" />
            <charts:ChartControl Grid.Row="1" x:Name="WeekdayChart" Kind="Bar"
                                 Accent="{DynamicResource KmAccentBrush}"
                                 Axis="{DynamicResource KmBorderBrush}"
                                 Label="{DynamicResource KmTextTertiaryBrush}" />
          </Grid>
        </Border>
        <Border Grid.Column="2" Background="{DynamicResource KmSurfaceBrush}" BorderBrush="{DynamicResource KmBorderBrush}"
                BorderThickness="0.5" CornerRadius="10" Padding="14,12">
          <Grid RowDefinitions="Auto,*" RowSpacing="8">
            <TextBlock Grid.Row="0" x:Name="TopTitle" FontSize="12" Foreground="{DynamicResource KmTextSecondaryBrush}" />
            <charts:ChartControl Grid.Row="1" x:Name="TopChart" Kind="HBar"
                                 Accent="{DynamicResource KmAccentBrush}"
                                 Axis="{DynamicResource KmBorderBrush}"
                                 Label="{DynamicResource KmTextTertiaryBrush}" />
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="2" Background="{DynamicResource KmSurfaceBrush}" BorderBrush="{DynamicResource KmBorderBrush}"
              BorderThickness="0.5" CornerRadius="10" Padding="14,12">
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{x:Static shared:Strings.Ui_Stats_Calendar}" FontSize="12"
                       Foreground="{DynamicResource KmTextSecondaryBrush}" VerticalAlignment="Center" />
            <!-- 年份选择器:条目来自当前数据域里真正出现过的年份(见 StatisticsWindow.RefreshCalendar),
                 只有一年数据时整条隐藏 —— 单项下拉框没有意义,还会白占标题行的位置。
                 高度压到 26 是为了不把下方的热力图挤扁(全局 ComboBox 样式是 MinHeight 30)。 -->
            <ComboBox Grid.Column="1" x:Name="CalendarYearBox" MinWidth="76" MinHeight="26" Height="26"
                      Padding="8,2" FontSize="12" VerticalAlignment="Center" IsVisible="False"
                      SelectionChanged="OnCalendarYearChanged" />
          </Grid>
          <charts:ChartControl Grid.Row="1" x:Name="CalendarChart" Kind="Heatmap"
                               Accent="{DynamicResource KmAccentBrush}"
                               Axis="{DynamicResource KmBorderBrush}"
                               Label="{DynamicResource KmTextTertiaryBrush}" />
        </Grid>
      </Border>

      <TextBlock Grid.Row="3" x:Name="EmptyHint" Classes="tt" Text="{x:Static shared:Strings.Ui_Stats_Empty}" IsVisible="False" Margin="2,0" />
    </Grid>

  </DockPanel>
</Window>
