<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:KindleMate2.Avalonia.ViewModels"
        xmlns:shared="using:KindleMate2.Shared"
        x:Class="KindleMate2.Avalonia.Views.AboutWindow"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="384"
        x:DataType="vm:AboutViewModel"
        Title="{x:Static shared:Strings.Ui_About_Title}"
        Icon="/Assets/bookmark.ico"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False" ShowInTaskbar="False">

  <StackPanel Margin="24,20,24,18" Spacing="16">

    <StackPanel Orientation="Horizontal" Spacing="12">
      <Image Width="40" Height="40" Source="/Assets/bookmark.png"
             Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding Product}" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Classes="tt" Text="{Binding VersionLabel}" />
      </StackPanel>
    </StackPanel>

    <Rectangle Height="1" Fill="{DynamicResource KmBorderBrush}" />

    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="9">
      <TextBlock Grid.Row="0" Grid.Column="0" Classes="tt" Text="{x:Static shared:Strings.Copyright}" VerticalAlignment="Center" />
      <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12" Text="{Binding Copyright}"
                 TextWrapping="Wrap" VerticalAlignment="Center" />

      <!-- 两行路径逐属性同构,差别只在绑定的值和处理函数。
           刻意用纯字符串 Content 而不是在按钮里套 TextBlock:全局 Style Selector="TextBlock"
           会把 Foreground 定死成 KmTextBrush(样式 setter 压过继承),套进按钮后文字会比「仓库」
           行更亮、悬停也不跟着变色 —— 那就不是一致样式了。
           路径可能很长,窗口宽固定 460 且不可缩放,所以靠 ToolTip 兜底完整值。
           三处链接一律 ghost+link:不吃 Button 基线的 MinHeight=28 —— 否则按钮所在的整行会被撑到
           28px,与纯文本行(约 16px)交替出现,六行之间就出现 25/31/37 三种行距(见 App.axaml)。 -->
      <TextBlock Grid.Row="1" Grid.Column="0" Classes="tt" Text="{x:Static shared:Strings.Program_Path}" VerticalAlignment="Center" />
      <Button Grid.Row="1" Grid.Column="1" Classes="ghost link" HorizontalAlignment="Left"
              Content="{Binding ProgramPath}" ToolTip.Tip="{Binding ProgramPath}" Click="OnOpenProgramPath" />

      <TextBlock Grid.Row="2" Grid.Column="0" Classes="tt" Text="{x:Static shared:Strings.Ui_About_DataPath}" VerticalAlignment="Center" />
      <Button Grid.Row="2" Grid.Column="1" Classes="ghost link" HorizontalAlignment="Left"
              Content="{Binding DataPath}" ToolTip.Tip="{Binding DataPath}" Click="OnOpenDataPath" />

      <TextBlock Grid.Row="3" Grid.Column="0" Classes="tt" Text="{x:Static shared:Strings.Database}" VerticalAlignment="Center" />
      <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <TextBlock FontSize="12" Text="{Binding DatabaseName}" TextTrimming="CharacterEllipsis" />
        <TextBlock Classes="tt" Text="{Binding DatabaseSizeLabel}" VerticalAlignment="Center" />
      </StackPanel>

      <TextBlock Grid.Row="4" Grid.Column="0" Classes="tt" Text="{x:Static shared:Strings.Ui_About_Runtime}" VerticalAlignment="Center" />
      <TextBlock Grid.Row="4" Grid.Column="1" FontSize="12" Text="{Binding Runtime}" VerticalAlignment="Center" />

      <TextBlock Grid.Row="5" Grid.Column="0" Classes="tt" Text="{x:Static shared:Strings.Ui_About_Repo}" VerticalAlignment="Center" />
      <Button Grid.Row="5" Grid.Column="1" Classes="ghost link" HorizontalAlignment="Left"
              Content="{Binding RepoUrl}" Click="OnOpenRepo" />
    </Grid>

    <!-- 底部原来还挂着一行「完整库文件路径」(MaxWidth=260、不可点、tt 色),内容和上面「数据路径」只差一个 /KM2.dat
         —— 已删:路径信息统一由「程序路径 / 数据路径」两行可点链接承担。
         列定义仍保留 "*,Auto",让确定按钮继续右对齐。 -->
    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
      <Button Grid.Column="1" Classes="primary" Content="{x:Static shared:Strings.Ui_Action_Ok}" Click="OnClose" />
    </Grid>

  </StackPanel>
</Window>
