<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS 代码签名(Developer ID + hardened runtime)所需 entitlements。

  .NET(Avalonia)是 JIT 运行时,在 hardened runtime 下必须显式放行 JIT 与可执行内存,
  否则签名后应用一启动就崩;`disable-library-validation` 用于加载随包内嵌的 libmtp/libusb
  等非同一 Team 签名的原生库。
  仅在配置了 Developer ID 证书时随 `codesign --entitlements` 使用;ad-hoc 签名不带。
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
