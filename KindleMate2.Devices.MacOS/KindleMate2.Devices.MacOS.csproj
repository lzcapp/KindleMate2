<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>KindleMate2.Devices.MacOS</RootNamespace>
    <AssemblyName>KindleMate2.Devices.MacOS</AssemblyName>
  </PropertyGroup>

  <!--
    macOS 专有的 Kindle 设备实现(枚举 /Volumes + 内容特征判定 + 定时轮询;MTP 走 libmtp P/Invoke)。
    之所以独立成项目:与 Devices.Windows 对称,平台专有逻辑不污染 Application 层;
    Application 只保留 IDeviceManager 接口,由各平台程序集提供实现。

    TFM 用中性的 net10.0 而非 net10.0-macos:本实现只用 BCL 与 libmtp(动态加载,缺失即降级),
    没有任何编译期平台依赖,因此可以在 Linux/Windows 上一起编译 —— 这正合 build.yml
    「在 ubuntu / windows 上构建整个解决方案」的既有做法,不必为它开特例。
    实际装配由 Avalonia.csproj 里的 IsOSPlatform('OSX') 条件引用控制。
    libmtp 的绑定是 internal,仅对测试工程开放,以免把内部互操作细节暴露成公共 API。
  -->
  <ItemGroup>
    <ProjectReference Include="..\KindleMate2.Application\KindleMate2.Application.csproj" />
    <ProjectReference Include="..\KindleMate2.Shared\KindleMate2.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KindleMate2.Tests" />
  </ItemGroup>

</Project>
