<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 跨平台:设备等 Windows 专有实现已拆到 KindleMate2.Devices.Windows -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KindleMate2.Domain\KindleMate2.Domain.csproj" />
    <ProjectReference Include="..\KindleMate2.Infrastructure\KindleMate2.Infrastructure.csproj" />
    <ProjectReference Include="..\KindleMate2.Shared\KindleMate2.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Leisn.MarkdigToc" Version="0.1.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- 平台相关脚本的生成、运行时标识归一化等属于实现细节,只对测试工程开放:
         它们需要被完整验证(尤其是替换脚本),但不该成为公共 API 让人误用。 -->
    <InternalsVisibleTo Include="KindleMate2.Tests" />
  </ItemGroup>

</Project>
